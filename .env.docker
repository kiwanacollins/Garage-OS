# Docker environment configuration for local development
# Copy this to .env for docker compose usage

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://garageos:garageos_dev@postgres:5432/garageos"
POSTGRES_USER="garageos"
POSTGRES_PASSWORD="garageos_dev"
POSTGRES_DB="garageos"

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="dev_jwt_secret_change_in_production"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_change_in_production"

# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3001
HOST="0.0.0.0"
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:3000"

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://redis:6379"
REDIS_PASSWORD=""

# ─── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_STORAGE_DIR="/app/uploads"
UPLOAD_MAX_BYTES=10485760
UPLOAD_PUBLIC_BASE_URL="http://localhost:3001/uploads"

# ─── Email ─────────────────────────────────────────────────────────────────────
SMTP_URL="smtp://mailhog:1025"
MAIL_FROM="GarageOS <no-reply@garageos.local>"

# ─── PesaPal ───────────────────────────────────────────────────────────────────
PESAPAL_BASE_URL="https://cybqa.pesapal.com/pesapalv3"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_CALLBACK_URL="http://localhost:3000/payment/callback"
PESAPAL_NOTIFICATION_ID=""

# ─── Web (Next.js) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── Domains (for production) ──────────────────────────────────────────────────
WEB_DOMAIN="localhost"
API_DOMAIN="localhost"