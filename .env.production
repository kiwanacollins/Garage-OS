# Production environment template for Coolify deployment
# Configure these values in Coolify's environment variables

# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=garageos
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=garageos

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_SECURE_JWT_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_SECURE_REFRESH_SECRET_AT_LEAST_32_CHARS

# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=https://your-domain.com

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD

# ─── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=10485760
UPLOAD_PUBLIC_BASE_URL=https://api.your-domain.com/uploads

# ─── Email ─────────────────────────────────────────────────────────────────────
SMTP_URL=smtp://username:password@smtp-server:587
MAIL_FROM=GarageOS <no-reply@your-domain.com>

# ─── PesaPal ───────────────────────────────────────────────────────────────────
PESAPAL_BASE_URL=https://pay.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=YOUR_PESAPAL_CONSUMER_KEY
PESAPAL_CONSUMER_SECRET=YOUR_PESAPAL_CONSUMER_SECRET
PESAPAL_CALLBACK_URL=https://your-domain.com/payment/callback
PESAPAL_NOTIFICATION_ID=YOUR_PESAPAL_NOTIFICATION_ID

# ─── Web (Next.js) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# ─── Domains ───────────────────────────────────────────────────────────────────
WEB_DOMAIN=your-domain.com
API_DOMAIN=api.your-domain.com