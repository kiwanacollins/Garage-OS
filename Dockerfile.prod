# Production Dockerfile for GarageOS
# ─────────────────────────────────────────────────────────────────────────────
# STRATEGY: Single builder stage runs npm install + npm run build.
# Runtime stages only COPY pre-built artifacts from builder — zero network
# calls needed after the builder stage completes.
# ─────────────────────────────────────────────────────────────────────────────

# ============================================================================
# Base — shared by all stages
# ============================================================================
FROM node:20-alpine AS base
WORKDIR /app

RUN apk add --no-cache libc6-compat

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

# Entrypoint: generates Prisma client on first start, then execs CMD.
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# ============================================================================
# Builder — installs ALL deps and compiles everything
# ============================================================================
FROM base AS builder

# Copy package manifests and npm config first (layer-cache friendly)
COPY package*.json ./
COPY .npmrc* ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY workers/queue/package.json ./workers/queue/
COPY packages/db/package.json ./packages/db/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/validation/package.json ./packages/validation/

# Use npm install (not npm ci) — workspace packages may not be in lock file
RUN npm install

# Copy full source
COPY . .

# Generate Prisma client (no network needed, uses local schema)
RUN npx prisma generate --schema=packages/db/prisma/schema.prisma

# Build all packages and apps via Turbo
RUN npm run build

# ============================================================================
# API runtime
# ============================================================================
FROM base AS api

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=nodejs:nodejs /app/packages ./packages
COPY --chown=nodejs:nodejs package.json ./
COPY --chown=nodejs:nodejs apps/api/package.json ./apps/api/

RUN mkdir -p /app/uploads && chown -R nodejs:nodejs /app/uploads

USER nodejs
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3001/api/v1/health || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "apps/api/dist/server.js"]

# ============================================================================
# Web runtime (Next.js standalone)
# ============================================================================
FROM base AS web

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nodejs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nodejs:nodejs /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nodejs:nodejs /app/packages ./packages

USER nodejs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000 || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "apps/web/server.js"]

# ============================================================================
# Queue Worker runtime
# ============================================================================
FROM base AS queue

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/workers/queue/dist ./workers/queue/dist
COPY --from=builder --chown=nodejs:nodejs /app/packages ./packages
COPY --chown=nodejs:nodejs package.json ./
COPY --chown=nodejs:nodejs workers/queue/package.json ./workers/queue/

USER nodejs

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "workers/queue/dist/index.js"]

# ============================================================================
# Migrate — Prisma migrate deploy + seed
# ============================================================================
FROM base AS migrate

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/packages ./packages
COPY --chown=nodejs:nodejs package.json ./

USER nodejs

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["sh", "-c", "npx prisma migrate deploy --schema=packages/db/prisma/schema.prisma && npx tsx packages/db/prisma/seed.ts"]